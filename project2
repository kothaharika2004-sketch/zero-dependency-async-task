import tkinter as tk
from tkinter import messagebox
import ast
import operator

# Supported operations
operations = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow
}

history = []
current_step = 0


# Evaluate expressions
def evaluate(node, variables):

    if isinstance(node, ast.Constant):
        return node.value

    elif isinstance(node, ast.Name):
        return variables[node.id]

    elif isinstance(node, ast.BinOp):
        left = evaluate(node.left, variables)
        right = evaluate(node.right, variables)

        return operations[type(node.op)](left, right)

    elif isinstance(node, ast.UnaryOp):
        value = evaluate(node.operand, variables)

        if isinstance(node.op, ast.USub):
            return -value

        if isinstance(node.op, ast.UAdd):
            return +value

    raise ValueError("Unsupported expression")


# Run and analyze Python code
def run_code():

    global history, current_step

    code = code_input.get("1.0", "end-1c")

    variables = {}
    output = ""
    history = []
    current_step = 0

    try:
        tree = ast.parse(code)

        for statement in tree.body:

            # Assignment
            if isinstance(statement, ast.Assign):

                value = evaluate(statement.value, variables)

                for target in statement.targets:

                    if isinstance(target, ast.Name):
                        variables[target.id] = value
                    else:
                        raise ValueError("Only simple variables supported")

            # Variable update
            elif isinstance(statement, ast.AugAssign):

                if not isinstance(statement.target, ast.Name):
                    raise ValueError("Only simple variables supported")

                name = statement.target.id
                old_value = variables[name]
                new_value = evaluate(statement.value, variables)

                variables[name] = operations[type(statement.op)](
                    old_value, new_value
                )

            # Print statement
            elif isinstance(statement, ast.Expr):

                call = statement.value

                if (isinstance(call, ast.Call)
                    and isinstance(call.func, ast.Name)
                    and call.func.id == "print"):

                    values = [
                        evaluate(arg, variables)
                        for arg in call.args
                    ]

                    output += " ".join(map(str, values)) + "\n"

                else:
                    raise ValueError("Only print() calls are supported")

            else:
                raise ValueError("Unsupported Python statement")

            # Store execution history
            history.append({
                "variables": variables.copy(),
                "output": output,
                "line": statement.lineno
            })

        if not history:
            messagebox.showinfo("Info", "No executable statements found")
            return

        show_step()

    except Exception as error:
        history = []
        messagebox.showerror("Error", str(error))


# Display execution history
def show_step():

    if not history:
        return

    step = history[current_step]

    step_label.config(
        text=f"Execution Step: {current_step + 1} / {len(history)}"
             f"     Line: {step['line']}"
    )

    # Display variable history
    variable_text.config(state=tk.NORMAL)
    variable_text.delete("1.0", tk.END)

    if step["variables"]:
        for name, value in step["variables"].items():
            variable_text.insert(
                tk.END, f"{name} = {value}\n"
            )
    else:
        variable_text.insert(tk.END, "No variables assigned yet.")

    variable_text.config(state=tk.DISABLED)

    # Display program output
    output_text.config(state=tk.NORMAL)
    output_text.delete("1.0", tk.END)

    if step["output"]:
        output_text.insert(tk.END, step["output"])
    else:
        output_text.insert(tk.END, "No output produced yet.")

    output_text.config(state=tk.DISABLED)

    # Update navigation buttons
    previous_button.config(
        state=tk.NORMAL if current_step > 0 else tk.DISABLED
    )

    next_button.config(
        state=tk.NORMAL if current_step < len(history) - 1
        else tk.DISABLED
    )


# Previous execution
def previous_step():

    global current_step

    if current_step > 0:
        current_step -= 1
        show_step()


# Next execution
def next_step():

    global current_step

    if current_step < len(history) - 1:
        current_step += 1
        show_step()


